# Worktree 隔离。每个需要启动服务的 worktree 必须使用唯一值和端口。
COMPOSE_PROJECT_NAME=chalk-main
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
WEB_PORT=3002

# Database (业务数据：用户、对话元数据、工具审批等)
DATABASE_URL=postgresql://chalk:chalk@localhost:5432/chalk
# 集成测试入口只接受本地、以 _test 结尾且不同于 DATABASE_URL 的数据库。
TEST_DATABASE_URL=postgresql://chalk:chalk@localhost:5432/chalk_main_test

# 独立 API 服务与 Web 来源
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
NEXT_PUBLIC_API_URL=http://localhost:3001
# Docker deployment overrides (used by docker-compose.deploy.yml)
PUBLIC_API_URL=http://localhost:3001
DEPLOY_WEB_ORIGIN=http://localhost:3000

# Session 存储
SESSION_BACKEND=jsonl  # 'jsonl' | 'postgres'(未来支持)
SESSIONS_ROOT=./data/sessions  # 相对于 apps/api 工作目录；只存 Pi 对话 JSONL

# Auth（生产环境必须启用 HTTPS cookie）
SESSION_COOKIE_SECURE=false

# Sensitive tool calls are rejected if not approved before this deadline.
TOOL_APPROVAL_TIMEOUT_MS=120000

# LightRAG Python sidecar (internal API only)
RAG_SIDECAR_URL=http://127.0.0.1:8010
# Set a unique secret shared only by the API and sidecar. Startup fails if empty.
RAG_SIDECAR_TOKEN=
RAG_TIMEOUT_MS=30000
RAG_WORKING_DIR=./data/rag
RAG_HOST=127.0.0.1
RAG_PORT=8010
RAG_LLM_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
# Optional separate OpenAI-compatible endpoints/keys. Useful when the LLM
# provider (for example DeepSeek) does not expose an embeddings API.
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=100
# Parser before LightRAG ingestion: text_only (default), markitdown, or mineru.
RAG_PARSER_ENGINE=mineru
# MinerU is optional and external (local CLI or hosted API). The hosted
# precision API with the VLM model is the recommended deployment default.
RAG_MINERU_MODE=cloud
RAG_MINERU_CLI_PATH=
RAG_MINERU_API_TOKEN=
RAG_MINERU_API_BASE_URL=https://mineru.net
RAG_MINERU_OCR=true
RAG_MINERU_ENABLE_FORMULA=true
RAG_MINERU_ENABLE_TABLE=true
RAG_MINERU_MODEL_VERSION=vlm
RAG_MINERU_LANGUAGE=
# Set true only when the deployment requires HTTP(S)_PROXY for MinerU/CDN.
RAG_MINERU_TRUST_ENV=false
# Optional reranker endpoint. Leave empty to use LightRAG's un-reranked candidates.
RAG_RERANK_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3.7-text-rerank

# LLM Providers — 可在 .env 配置，也可在 /settings/providers 页面填写
# Web UI 配置优先；env 作为 fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
# Azure / Bedrock / Vertex 等按 pi-ai 规范配置对应 env

# Media Providers — 用户在 Settings 保存的凭据优先；env 作为部署级 fallback。
# 能力专用变量优先于通用供应商变量，例如 IMAGE_SEEDREAM_API_KEY 优先于 ARK_API_KEY。
ARK_API_KEY=                       # Seedream + Seedance 共用 fallback
IMAGE_SEEDREAM_API_KEY=
IMAGE_SEEDREAM_BASE_URL=
VIDEO_SEEDANCE_API_KEY=
VIDEO_SEEDANCE_BASE_URL=
TTS_OPENAI_API_KEY=               # 未配置时 fallback 到 OPENAI_API_KEY
TTS_OPENAI_BASE_URL=
ASR_OPENAI_API_KEY=               # 未配置时 fallback 到 OPENAI_API_KEY
ASR_OPENAI_BASE_URL=
# 其他媒体 Provider 遵循 <CAPABILITY>_<PROVIDER>_API_KEY / _BASE_URL；
# Google/OpenAI/Qwen/MiniMax/Grok 等在专用 key 缺失时会回退到同名通用 LLM key。

# Encryption key for API key storage in DB (AES-256-GCM, hex 32 bytes)
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# OpenTelemetry (可选，不填则只用内存 span 快照)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Development accounts (仅在非 production 环境可用)
DEV_ADMIN_EMAIL=admin@qq.com
DEV_ADMIN_PASSWORD=admin123
DEV_USER_EMAIL=user@qq.com
DEV_USER_PASSWORD=user123

# Skills directories (colon-separated paths)
SKILLS_DIRS=./skills

# Context7 MCP (test-only, remote, lazy-connected documentation server)
# Enable explicitly only for local/integration smoke tests.
CONTEXT7_MCP_ENABLED=false
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
# Optional; recommended for higher rate limits. Never commit the key.
CONTEXT7_API_KEY=

# S3 / OSS (对象存储)
# 开发：MinIO 本地（http://localhost:9000）
# 生产：阿里云 OSS（设置 endpoint 为阿里云地域，例如 oss-cn-hangzhou.aliyuncs.com）
S3_ENDPOINT=http://localhost:9000  # 开发用 MinIO；生产用阿里云 OSS endpoint
# Optional public endpoint used only for browser upload presigned URLs. Set
# this when S3_ENDPOINT is an internal Docker service name (for example
# S3_ENDPOINT=http://minio:9000 and S3_PRESIGN_ENDPOINT=http://localhost:9000).
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1                # 开发用；生产改为 oss-cn-hangzhou
S3_ACCESS_KEY_ID=chalk             # 生产用阿里云 AccessKey ID
S3_SECRET_ACCESS_KEY=chalk-minio-secret  # 生产用阿里云 AccessKey Secret
S3_BUCKET_UPLOADS=chalk-uploads    # 用户上传文件（开发 MinIO bucket；生产 OSS bucket）
S3_BUCKET_BACKUPS=chalk-backups    # 备份文件
S3_PUBLIC_URL=                     # 可选：仅在明确配置私有 CDN/访问策略时填写
