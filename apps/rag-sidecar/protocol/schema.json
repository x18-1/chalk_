{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chalk RAG sidecar protocol",
  "type": "object",
  "properties": {
    "indexRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "knowledgeBaseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "contentType": {
          "type": "string",
          "enum": [
            "text/plain",
            "text/markdown",
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        },
        "contentBase64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "knowledgeBaseId",
        "documentId",
        "filename",
        "contentType",
        "contentBase64"
      ],
      "additionalProperties": false
    },
    "indexResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "status": {
          "type": "string",
          "const": "ready"
        },
        "chunkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "documentId",
        "status",
        "chunkCount",
        "pageCount"
      ],
      "additionalProperties": false
    },
    "queryRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "knowledgeBaseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mode": {
          "type": "string",
          "enum": [
            "hybrid",
            "naive",
            "local",
            "global",
            "mix"
          ]
        },
        "topK": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "enableRerank": {
          "type": "boolean"
        }
      },
      "required": [
        "knowledgeBaseId",
        "query",
        "mode",
        "topK",
        "enableRerank"
      ],
      "additionalProperties": false
    },
    "queryResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "citationId": {
                "type": "string",
                "minLength": 1
              },
              "documentId": {
                "type": "string",
                "minLength": 1
              },
              "documentName": {
                "type": "string",
                "minLength": 1
              },
              "chunkId": {
                "type": "string",
                "minLength": 1
              },
              "snippet": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "paragraph": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "citationId",
              "documentId",
              "documentName",
              "chunkId",
              "snippet"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            },
            "reranked": {
              "type": "boolean"
            },
            "latencyMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "provider",
            "mode",
            "reranked",
            "latencyMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "answer",
        "references",
        "metadata"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "indexRequest",
    "indexResponse",
    "queryRequest",
    "queryResponse"
  ],
  "additionalProperties": false
}
