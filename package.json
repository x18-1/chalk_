{
  "name": "chalk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @chalk/api db:generate",
    "db:migrate": "pnpm --filter @chalk/api db:migrate",
    "db:studio": "pnpm --filter @chalk/api db:studio"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
