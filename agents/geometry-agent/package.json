{
  "name": "@chalk/geometry-agent-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "cli": "tsx src/cli.ts",
    "eval": "tsx eval/run-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "manim-web": "0.3.24",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vitest": "4.1.9"
  }
}
